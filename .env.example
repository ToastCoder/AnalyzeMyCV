# AnalyzeMyCV Configuration
# IMPORTANT: Never commit the .env file with real secrets to version control
# Copy this file to .env and fill in your actual values

# ==================== AZURE OPENAI ====================
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

# ==================== AUTHENTICATION ====================
# Users sign in through Azure App Service Authentication (Easy Auth); no user
# data is stored by this app. JWT_SECRET signs the short-lived tokens the
# Streamlit frontend sends to the internal FastAPI service.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Login endpoint of the identity provider configured in Easy Auth.
# /.auth/login/aad for the Microsoft provider (Entra ID / External ID);
# /.auth/login/<name> for a custom OpenID Connect provider.
EASY_AUTH_LOGIN_PATH=/.auth/login/aad

# LOCAL DEVELOPMENT ONLY: Easy Auth doesn't exist locally, so this identity is
# used instead. Ignored on App Service, where a real sign-in is always required.
LOCAL_DEV_USER_EMAIL=dev@example.com

# ==================== APPLICATION SETTINGS ====================
API_URL=http://127.0.0.1:8080
DEBUG=False
