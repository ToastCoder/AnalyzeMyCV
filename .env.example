# AnalyzeMyCV Configuration
# IMPORTANT: Never commit the .env file with real secrets to version control
# Copy this file to .env and fill in your actual values

# ==================== AZURE OPENAI ====================
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

# ==================== AUTHENTICATION ====================
# Users sign in with Clerk (clerk.com); proxy.py verifies the session and no user
# data is stored by this app. JWT_SECRET (min 32 chars) also signs the proxy's session
# cookie and the short-lived tokens Streamlit sends to the internal FastAPI service.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Clerk Dashboard > API keys. Leave the publishable key empty for local development
# without Clerk; the app then signs you in as LOCAL_DEV_USER_EMAIL.
CLERK_PUBLISHABLE_KEY=
# Optional: lets the proxy show the user's email and name. Never commit a real value.
CLERK_SECRET_KEY=
# Optional: comma-separated site origins accepted in the session token, e.g. https://app.example.com
CLERK_AUTHORIZED_PARTIES=

# LOCAL DEVELOPMENT ONLY: used when CLERK_PUBLISHABLE_KEY is empty. Ignored on App Service.
LOCAL_DEV_USER_EMAIL=dev@example.com

# ==================== APPLICATION SETTINGS ====================
API_URL=http://127.0.0.1:8080
DEBUG=False
