# AnalyzeMyCV Configuration
# IMPORTANT: Never commit the .env file with real secrets to version control
# Copy this file to .env and fill in your actual values

# ==================== AZURE OPENAI ====================
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

# ==================== AZURE ENTRA ID (OAuth2) ====================
# Register your application at https://portal.azure.com
# Navigate to: Azure AD > App registrations > New registration
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_AUTH_REDIRECT_URI=http://localhost:8501/auth/callback

# ==================== AZURE SQL DATABASE ====================
# Connection string format:
# mssql+pyodbc://username:password@server.database.windows.net/database?driver=ODBC+Driver+17+for+SQL+Server
# For local development, you can use SQLite:
# sqlite:///./analyzemycv.db
AZURE_SQL_DATABASE_URL=mssql+pyodbc://username:password@server.database.windows.net/analyzemycv?driver=ODBC+Driver+17+for+SQL+Server

# ==================== APPLICATION SETTINGS ====================
API_URL=http://localhost:8080
DEBUG=False

# ==================== DEPLOYMENT ====================
# Production Azure Web App redirect URI (update after deploying to Azure)
# AZURE_AUTH_REDIRECT_URI=https://your-app-name.azurewebsites.net/auth/callback
